{
  "name": "openapi-drift",
  "version": "0.0.0",
  "description": "Keeps an OpenAPI document honest: compares it with the routes in your NestJS or Express code and reports the drift, as a CLI and a GitHub Action.",
  "keywords": [
    "openapi",
    "swagger",
    "nestjs",
    "express",
    "api-drift",
    "contract-testing",
    "github-action",
    "api-testing"
  ],
  "homepage": "https://github.com/vannt-dev/openapi-drift#readme",
  "bugs": {
    "url": "https://github.com/vannt-dev/openapi-drift/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vannt-dev/openapi-drift.git"
  },
  "license": "MIT",
  "author": "Van Nguyen",
  "type": "module",
  "bin": {
    "openapi-drift": "bin/openapi-drift.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test \"test/*.test.ts\"",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.2.1"
  }
}
